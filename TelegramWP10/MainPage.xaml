<Page
    x:Class="TelegramWP10.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TelegramWP10"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <Style x:Key="ChatInputStyle" TargetType="TextBox">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Grid>
                            <ScrollViewer x:Name="ContentElement" Margin="{TemplateBinding Padding}"
                                          HorizontalScrollMode="Auto" VerticalScrollMode="Auto"
                                          HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                            <TextBlock x:Name="PlaceholderTextContentPresenter"
                                       Text="{TemplateBinding PlaceholderText}"
                                       Foreground="#AAAAAA"
                                       Margin="{TemplateBinding Padding}"
                                       IsHitTestVisible="False"
                                       TextWrapping="{TemplateBinding TextWrapping}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid>
        <!-- Невидимый хост для воспроизведения аудио -->
        <StackPanel x:Name="AudioPlayerHost" Visibility="Collapsed" Width="0" Height="0"/>
        <Grid x:Name="StartPanel" Padding="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel x:Name="LoginPanel" Grid.Row="0" Visibility="Visible" Margin="0,0,0,10">
                <TextBlock x:Name="LoginStatus" Text="" Foreground="#0088cc" FontSize="14" Margin="0,0,0,10" TextWrapping="Wrap"/>
                <TextBox x:Name="PhoneInput" Header="Телефон" PlaceholderText="+7..." InputScope="TelephoneNumber"/>
                <Button x:Name="PhoneButton" Content="Далее" Click="SendPhone_Click" HorizontalAlignment="Stretch" Margin="0,10"/>
                <TextBox x:Name="CodeInput" Header="Код из Unogram" Visibility="Collapsed" Margin="0,10"/>
                <Button x:Name="CodeButton" Content="Войти" Click="SendCode_Click" Visibility="Collapsed" HorizontalAlignment="Stretch"/>
                <PasswordBox x:Name="PasswordInput" Header="Пароль 2FA" Visibility="Collapsed" Margin="0,10"/>
                <Button x:Name="PasswordButton" Content="Подтвердить" Click="SendPassword_Click" Visibility="Collapsed" HorizontalAlignment="Stretch"/>
            </StackPanel>

            <ListView x:Name="ChatListView" Grid.Row="1" Visibility="Collapsed" SelectionMode="None" IsItemClickEnabled="True" ItemClick="ChatListView_ItemClick">
                <ListView.Header>
                    <StackPanel Background="#1A1A1A">
                        <!-- Шапка главного списка -->
                        <StackPanel x:Name="MainListHeader">
                            <Grid Margin="15,15,15,2">
                                <TextBlock x:Name="UnogramTitle" Text="Unogram" Foreground="White" FontSize="28" FontWeight="Bold" VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button x:Name="ContactsButton" Content="👤" Click="ContactsButton_Click"
                                            Background="Transparent" Foreground="#888888"
                                            FontSize="18" Padding="8,4" BorderThickness="0"/>
                                    <Button x:Name="ThemeToggleButton" Content="☀" Click="ThemeToggle_Click"
                                            Background="Transparent" Foreground="#888888"
                                            FontSize="18" Padding="8,4" BorderThickness="0"/>
                                    <Button x:Name="SettingsButton" Content="⚙" 
                                            Background="Transparent" Foreground="#888888"
                                            FontSize="18" Padding="8,4" BorderThickness="0">
                                        <Button.Flyout>
                                            <MenuFlyout>
                                                <MenuFlyoutItem x:Name="ClearCacheItem" Text="🗑 Очистить кэш" Click="ClearCache_Click"/>
                                                <MenuFlyoutItem x:Name="SoundToggleItem" Text="🔔 Звук: Вкл" Click="SoundToggle_Click"/>
                                            </MenuFlyout>
                                        </Button.Flyout>
                                    </Button>
                                </StackPanel>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="15,0,15,10">
                                <TextBlock Text="Чатов: " Foreground="#888888" FontSize="13"/>
                                <TextBlock x:Name="ChatCountText" Text="0" Foreground="#888888" FontSize="13"/>
                                <ProgressRing x:Name="ConnectionProgressRing" IsActive="False"
                                              Width="14" Height="14" Foreground="#FF6666"
                                              Margin="8,0,4,0" VerticalAlignment="Center"
                                              Visibility="Collapsed"/>
                                <TextBlock x:Name="ConnectionStatusText" Text="" Foreground="#FF6666" FontSize="13" Margin="0,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                        <!-- Шапка архива -->
                        <StackPanel x:Name="ArchiveListHeader" Visibility="Collapsed">
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="ArchiveBackButton" Content="←" Click="ArchiveBack_Click"
                                        Background="Transparent" Foreground="White" FontSize="22"
                                        Padding="10,4,8,4" VerticalAlignment="Center" BorderThickness="0"/>
                                <TextBlock x:Name="ArchiveTitleText" Grid.Column="1" Text="Архив" Foreground="White"
                                           FontSize="26" FontWeight="Bold"
                                           VerticalAlignment="Center" Margin="0,0,0,4"/>
                            </Grid>
                            <TextBlock x:Name="ArchiveChatCountText" Text="" Foreground="#888888"
                                       FontSize="13" Margin="15,0,15,10"/>
                        </StackPanel>
                        <!-- Строка "Архив" (в главном списке) -->
                        <Border x:Name="ArchiveRow" Background="#222222" Tapped="ArchiveRow_Tapped"
                                Margin="0,2,0,0" Padding="0">
                            <Grid Margin="15,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="50"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <!-- Иконка папки -->
                                <Border Width="42" Height="42" CornerRadius="21"
                                        Background="#444444" HorizontalAlignment="Left">
                                    <TextBlock Text="📁" FontSize="20"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="ArchiveRowTitle" Text="Архив" Foreground="White"
                                               FontSize="16" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="ArchiveSubtitleText" Text="архивированные чаты"
                                               Foreground="#888888" FontSize="13"
                                               TextTrimming="CharacterEllipsis" MaxLines="1" TextWrapping="NoWrap"/>
                                </StackPanel>
                                <Grid Grid.Column="2" VerticalAlignment="Center" Margin="4,0,0,0">
                                    <!-- Бейдж непрочитанных -->
                                    <Border x:Name="ArchiveUnreadBadge" Background="#888888"
                                            CornerRadius="10" MinWidth="20" Height="20"
                                            Padding="5,0" HorizontalAlignment="Right"
                                            Visibility="Collapsed">
                                        <TextBlock x:Name="ArchiveUnreadText" Text="0"
                                                   Foreground="White" FontSize="12"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <!-- Стрелка (когда нет непрочитанных) -->
                                    <TextBlock x:Name="ArchiveArrow" Text="›" Foreground="#888888"
                                               FontSize="20" HorizontalAlignment="Right"
                                               VerticalAlignment="Center" Margin="0,0,2,0"/>
                                </Grid>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ListView.Header>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Holding="ChatItem_Holding">
                            <FlyoutBase.AttachedFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem x:Name="MenuPinChat" Text="📌 Закрепить" Click="PinChat_Click"/>
                                    <MenuFlyoutItem x:Name="MenuMarkUnread" Text="🔵 Отметить непрочитанным" Click="MarkUnread_Click"/>
                                    <MenuFlyoutItem x:Name="MenuArchiveChat" Text="📁 Переместить в архив" Click="ArchiveChat_Click"/>
                                    <MenuFlyoutItem Text="🗑 Удалить переписку" Click="DeleteChat_Click"/>
                                </MenuFlyout>
                            </FlyoutBase.AttachedFlyout>
                            <StackPanel>
                                <Grid Margin="12,8,12,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- Круглая аватарка через Ellipse -->
                                    <Grid Width="60" VerticalAlignment="Top">
                                        <Ellipse Width="50" Height="50" HorizontalAlignment="Left">
                                            <Ellipse.Fill>
                                                <ImageBrush ImageSource="{Binding Photo}" Stretch="UniformToFill"/>
                                            </Ellipse.Fill>
                                        </Ellipse>
                                        <Ellipse Width="50" Height="50" HorizontalAlignment="Left"
                                                 Fill="#555555" Visibility="{Binding NoPhotoVisibility}"/>
                                        <Ellipse Width="14" Height="14" Fill="#22C55E"
                                                 HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                 Margin="0,0,2,0"
                                                 Visibility="{Binding OnlineVisibility}"/>
                                    </Grid>
                                    <!-- Текстовый блок -->
                                    <Grid Grid.Column="1" Margin="5,0,0,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <!-- Строка 1: название + время -->
                                        <Grid Grid.Row="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="📌 " FontSize="12" Foreground="#888888"
                                                           Visibility="{Binding PinVisibility}" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Title}" Foreground="{Binding TitleColor}" FontSize="16" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding LastMessageTime}" Foreground="{Binding TimeColor}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                        </Grid>
                                        <!-- Строка 2: последнее сообщение + бейдж -->
                                        <Grid Grid.Row="1" Margin="0,2,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding LastMessage}" Foreground="{Binding SubtitleColor}" FontSize="13" TextTrimming="CharacterEllipsis" MaxLines="1" TextWrapping="NoWrap"/>
                                            <TextBlock Grid.Column="1" Text="{Binding StatusText}" Foreground="{Binding StatusColor}" FontSize="13"
                                                       VerticalAlignment="Center" Margin="6,0,0,0"
                                                       Visibility="{Binding StatusVisibility}"/>
                                            <Border Grid.Column="1" Background="#0088cc" CornerRadius="10" MinWidth="20" Height="20"
                                                    VerticalAlignment="Center" Margin="6,0,0,0"
                                                    Visibility="{Binding UnreadVisibility}" Padding="4,0">
                                                <TextBlock Text="{Binding UnreadText}" Foreground="White" FontSize="11"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <Border Grid.Column="1" Background="Transparent" BorderBrush="#0088cc" BorderThickness="2"
                                                    CornerRadius="7" Width="14" Height="14"
                                                    VerticalAlignment="Center" Margin="6,0,0,0"
                                                    Visibility="{Binding MarkedUnreadVisibility}"/>
                                        </Grid>
                                    </Grid>
                                </Grid>
                                <!-- Разделитель -->
                                <Border Height="0.5" Background="#33888888" Margin="72,0,0,0"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Button x:Name="LogoutButton" Grid.Row="2" Content="Выход" Click="LogoutButton_Click"
                    HorizontalAlignment="Stretch" Margin="0,8,0,0"
                    Background="#AA222222" Foreground="#FF4444"
                    Visibility="Collapsed"/>
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,4">
                <TextBlock x:Name="ProxyStatusText" Text="" Foreground="#555555"
                           FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"
                           TextTrimming="CharacterEllipsis" Visibility="Collapsed"/>
                <Button x:Name="ProxySettingsButton" Content="Прокси" Click="ProxySettingsButton_Click"
                        FontSize="11" Padding="8,4" Background="#AA333333" Foreground="#AAAAAA"/>
            </StackPanel>
        </Grid>

        <!-- Popup настроек прокси -->
        <Popup x:Name="ProxyPopup" IsLightDismissEnabled="True">
            <Border Background="#1E1E1E" BorderBrush="#444" BorderThickness="1"
                    Width="320" MaxHeight="480" Padding="16" CornerRadius="8">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Настройки прокси" Foreground="White" FontSize="16"
                                   FontWeight="SemiBold" Margin="0,0,0,12"/>

                        <!-- Режим -->
                        <RadioButton x:Name="ProxyModeNone" Content="Без прокси (прямое подключение)"
                                     GroupName="ProxyMode" Foreground="#CCCCCC" Checked="ProxyMode_Checked"/>
                        <RadioButton x:Name="ProxyModeAuto" Content="Автовыбор прокси с сервера"
                                     GroupName="ProxyMode" Foreground="#CCCCCC" Margin="0,4,0,0" Checked="ProxyMode_Checked"/>
                        <RadioButton x:Name="ProxyModeMtproto" Content="MTProto"
                                     GroupName="ProxyMode" Foreground="#CCCCCC" Margin="0,4,0,0" Checked="ProxyMode_Checked"/>
                        <RadioButton x:Name="ProxyModeHttp" Content="HTTP"
                                     GroupName="ProxyMode" Foreground="#CCCCCC" Margin="0,4,0,0" Checked="ProxyMode_Checked"/>
                        <RadioButton x:Name="ProxyModeSocks" Content="SOCKS5"
                                     GroupName="ProxyMode" Foreground="#CCCCCC" Margin="0,4,0,12" Checked="ProxyMode_Checked"/>

                        <!-- MTProto поля -->
                        <StackPanel x:Name="MtprotoFields" Visibility="Collapsed">
                            <TextBox x:Name="MtpHost" Header="Хост / IP" PlaceholderText="example.com" Margin="0,0,0,6"/>
                            <TextBox x:Name="MtpPort" Header="Порт" PlaceholderText="443" InputScope="Number" Margin="0,0,0,6"/>
                            <TextBox x:Name="MtpSecret" Header="Секрет" PlaceholderText="dd..." Margin="0,0,0,12"/>
                        </StackPanel>

                        <!-- HTTP поля -->
                        <StackPanel x:Name="HttpFields" Visibility="Collapsed">
                            <TextBox x:Name="HttpHost" Header="Хост / IP" PlaceholderText="example.com" Margin="0,0,0,6"/>
                            <TextBox x:Name="HttpPort" Header="Порт" PlaceholderText="8080" InputScope="Number" Margin="0,0,0,12"/>
                        </StackPanel>

                        <!-- SOCKS5 поля -->
                        <StackPanel x:Name="SocksFields" Visibility="Collapsed">
                            <TextBox x:Name="SocksHost" Header="Хост / IP" PlaceholderText="example.com" Margin="0,0,0,6"/>
                            <TextBox x:Name="SocksPort" Header="Порт" PlaceholderText="1080" InputScope="Number" Margin="0,0,0,6"/>
                            <TextBox x:Name="SocksUser" Header="Логин (опционально)" PlaceholderText="" Margin="0,0,0,6"/>
                            <PasswordBox x:Name="SocksPass" Header="Пароль (опционально)" Margin="0,0,0,12"/>
                        </StackPanel>

                        <Button Content="Применить" Click="ProxyApply_Click"
                                HorizontalAlignment="Stretch" Background="#0088cc" Foreground="White"/>
                        <Button Content="Отмена" Click="ProxyCancel_Click"
                                HorizontalAlignment="Stretch" Background="Transparent" Foreground="#888888" Margin="0,6,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Popup>

        <Grid x:Name="MessagesPanel" Visibility="Collapsed" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel x:Name="ChatHeader" Orientation="Horizontal" Background="#0088cc" Padding="10">
                <Button x:Name="BackButton" Content="←" Click="BackButton_Click" Foreground="White" Background="Transparent" FontSize="20"/>
                <!-- Аватарка собеседника — круглая -->
                <Grid Width="36" Height="36" VerticalAlignment="Center" Margin="6,0,0,0">
                    <Ellipse x:Name="ChatHeaderAvatarBorder" Width="36" Height="36" Fill="#555555"/>
                    <Ellipse x:Name="ChatHeaderAvatarEllipse" Width="36" Height="36">
                        <Ellipse.Fill>
                            <ImageBrush x:Name="ChatHeaderAvatarBrush" Stretch="UniformToFill"/>
                        </Ellipse.Fill>
                    </Ellipse>
                </Grid>
                <StackPanel VerticalAlignment="Center" Margin="10,0">
                    <TextBlock x:Name="CurrentChatTitle" Text="Чат" Foreground="White" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock x:Name="CurrentChatStatus" Text="" Foreground="#CCE8FF" FontSize="13"/>
                </StackPanel>
            </StackPanel>

            <!-- Область сообщений: ScrollViewer + оверлеи в одном Grid -->
            <Grid Grid.Row="1">
            <ScrollViewer x:Name="MessagesScrollViewer"
                          VerticalScrollMode="Enabled" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled"
                          ViewChanged="MessagesScrollViewer_ViewChanged">
            <ListView x:Name="MessagesListView" SelectionMode="None" Padding="10,10,10,12" IsItemClickEnabled="True" ItemClick="MessagesListView_ItemClick" Visibility="Collapsed">
                <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel/>
                    </ItemsPanelTemplate>
                </ListView.ItemsPanel>
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="0"/>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <!-- Разделитель дат -->
                            <Border Visibility="{Binding SeparatorVisibility}" HorizontalAlignment="Stretch" Margin="0,6,0,6">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Border Background="{Binding SeparatorBackground}" CornerRadius="10" Padding="12,4">
                                        <TextBlock Text="{Binding SeparatorLabel}" FontSize="12" Foreground="{Binding SeparatorTextColor}" FontWeight="SemiBold"/>
                                    </Border>
                                </StackPanel>
                            </Border>
                            <!-- Пузырь сообщения -->
                            <Border Background="{Binding BubbleBackground}" Padding="{Binding BubblePadding}" Margin="0,4" CornerRadius="10" HorizontalAlignment="{Binding Alignment}"
                                    Visibility="{Binding MessageVisibility}"
                                    Holding="MessageBubble_Holding">
                            <FlyoutBase.AttachedFlyout>
                                <MenuFlyout>
                                    <!-- Быстрые реакции -->
                                    <MenuFlyoutItem Text="👍 Нравится" Click="React_Click" Tag="👍"/>
                                    <MenuFlyoutItem Text="❤ Сердце" Click="React_Click" Tag="❤"/>
                                    <MenuFlyoutItem Text="🔥 Огонь" Click="React_Click" Tag="🔥"/>
                                    <MenuFlyoutItem Text="🤣 Смех" Click="React_Click" Tag="🤣"/>
                                    <MenuFlyoutItem Text="😢 Грусть" Click="React_Click" Tag="😢"/>
                                    <MenuFlyoutItem Text="👎 Не нравится" Click="React_Click" Tag="👎"/>
                                    <MenuFlyoutSeparator/>
                                    <MenuFlyoutItem Text="↩ Ответить" Click="ReplyMessage_Click"/>
                                    <MenuFlyoutItem Text="↪ Переслать" Click="ForwardMessage_Click"/>
                                    <MenuFlyoutItem Text="📋 Копировать текст" Click="CopyMessage_Click"/>
                                    <MenuFlyoutItem x:Name="MenuEdit" Text="✏ Редактировать" Click="EditMessage_Click"/>
                                    <MenuFlyoutItem x:Name="MenuDeleteSelf" Text="🗑 Удалить сообщение" Click="DeleteMessageSelf_Click"/>
                                    <MenuFlyoutItem x:Name="MenuDeleteAll" Text="🗑 Удалить у всех" Click="DeleteMessageAll_Click"/>
                                </MenuFlyout>
                            </FlyoutBase.AttachedFlyout>
                            <StackPanel MaxWidth="260">
                                <!-- Ник отправителя (только входящие в группах) -->
                                <TextBlock Text="{Binding SenderName}" FontSize="12" FontWeight="Bold"
                                           Foreground="{Binding SenderColor}"
                                           Visibility="{Binding SenderNameVisibility}"
                                           Margin="0,0,0,3"/>

                                <!-- Переслано от -->
                                <StackPanel Orientation="Horizontal" Visibility="{Binding ForwardedVisibility}" Margin="0,0,0,4">
                                    <TextBlock Text="↪ " Foreground="#7EC8E3" FontSize="12"/>
                                    <TextBlock Text="{Binding ForwardedFrom}" Foreground="#7EC8E3" FontSize="12"
                                               FontStyle="Italic" TextTrimming="CharacterEllipsis" MaxWidth="220"/>
                                </StackPanel>

                                <!-- Цитата -->
                                <Border Background="{Binding ReplyBackground}" BorderBrush="{Binding ReplyBorderBrush}" BorderThickness="2,0,0,0" Margin="0,0,0,5" Padding="5,2" Visibility="{Binding ReplyVisibility}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding ReplyAuthor}" FontSize="11" FontWeight="Bold"
                                                   Foreground="{Binding ReplyAuthorColor}" Visibility="{Binding ReplyAuthorVisibility}"/>
                                        <TextBlock Text="{Binding ReplyToText}" FontSize="12" Foreground="{Binding ReplyTextColor}" TextTrimming="CharacterEllipsis" MaxLines="2"/>
                                    </StackPanel>
                                </Border>

                                <!-- Фото / Видео (превью + иконка воспроизведения) -->
                                <Grid Visibility="{Binding PhotoVisibility}" Margin="0,0,0,5">
                                    <Image Source="{Binding AttachedPhoto}" Stretch="Uniform" MaxWidth="{Binding PhotoMaxWidth}" MaxHeight="{Binding PhotoMaxWidth}"
                                           Tapped="PhotoImage_Tapped"/>
                                    <TextBlock Text="▶" Foreground="White" FontSize="40" VerticalAlignment="Center" HorizontalAlignment="Center"
                                               Visibility="{Binding VideoIconVisibility}" Opacity="0.8" IsHitTestVisible="False"/>
                                    <Border VerticalAlignment="Center" HorizontalAlignment="Center"
                                            Background="#88000000" Padding="6,2"
                                            Visibility="{Binding VideoProgressVisibility}">
                                        <TextBlock Text="{Binding VideoDownloadProgress}" Foreground="White"
                                                   FontSize="14" FontWeight="Bold" IsHitTestVisible="False"/>
                                    </Border>
                                </Grid>

                                <!-- GIF: MediaElement авто-воспроизведение (без превью) -->
                                <Grid Visibility="{Binding GifPlayerVisibility}" Margin="0,0,0,5"
                                      MaxWidth="250" Tapped="PhotoImage_Tapped">
                                    <MediaElement x:Name="GifPlayer"
                                                  Source="{Binding GifSource}"
                                                  AutoPlay="True" IsLooping="True"
                                                  IsMuted="True" AreTransportControlsEnabled="False"
                                                  Stretch="Uniform" MaxWidth="250"/>
                                    <!-- Прогресс скачивания GIF -->
                                    <Border VerticalAlignment="Center" HorizontalAlignment="Center"
                                            Background="#88000000" Padding="6,2"
                                            Visibility="{Binding VideoProgressVisibility}">
                                        <TextBlock Text="{Binding VideoDownloadProgress}" Foreground="White"
                                                   FontSize="14" FontWeight="Bold" IsHitTestVisible="False"/>
                                    </Border>
                                </Grid>

                                <!-- Документ -->
                                <!-- Опрос -->
                                <StackPanel Visibility="{Binding PollVisibility}" Margin="0,0,0,5" MinWidth="200">
                                    <TextBlock Text="{Binding PollType}" Foreground="#888888" FontSize="11" Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding PollQuestion}" Foreground="{Binding TextColor}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                    <ItemsControl ItemsSource="{Binding PollOptions}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Tag="{Binding}" Click="PollOption_Click"
                                                        HorizontalAlignment="Stretch" Margin="0,0,0,4"
                                                        Background="Transparent" BorderThickness="0" Padding="0">
                                                <StackPanel>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Text}" Foreground="{Binding TextColor}" FontSize="13" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding PercentText}" Foreground="{Binding TextColor}" Opacity="0.6" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                                    </Grid>
                                                    <!-- Полоска прогресса -->
                                                    <ProgressBar Value="{Binding Percent}" Maximum="100"
                                                                 Foreground="{Binding BarColor}"
                                                                 Background="#33FFFFFF"
                                                                 Height="4" Margin="0,3,0,0"/>
                                                    <TextBlock Text="{Binding VoteText}" Foreground="#888888" FontSize="11" Margin="0,2,0,0"/>
                                                </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <!-- Документ -->
                                <Border Visibility="{Binding DocumentVisibility}" Background="#22FFFFFF" CornerRadius="6" Padding="8,6" Margin="0,0,0,5">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="📄" FontSize="28" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DocumentName}" Foreground="{Binding TextColor}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding DocumentSize}" Foreground="#AAAAAA" FontSize="11"/>
                                            </StackPanel>
                                        </Grid>
                                        <Button Content="{Binding DownloadStatus}" Tag="{Binding Id}" Click="DocumentButton_Click"
                                                Margin="0,6,0,0" HorizontalAlignment="Stretch"
                                                Background="#0088cc" Foreground="White" FontSize="12" Padding="6,4"/>
                                    </StackPanel>
                                </Border>

                                <!-- Аудио -->
                                <Border Visibility="{Binding AudioVisibility}" Background="#22FFFFFF" CornerRadius="6" Padding="8,6" Margin="0,0,0,5">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Content="{Binding AudioPlayStatus}" Tag="{Binding Id}" Click="AudioButton_Click"
                                                Width="40" Height="40" Background="#0088cc" Foreground="White" FontSize="16"
                                                Padding="0" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding AudioTitle}" Foreground="White" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <Slider Tag="{Binding Id}" Minimum="0" Maximum="{Binding AudioDurationSeconds}"
                                                    Value="{Binding AudioPosition, Mode=OneWay}"
                                                    ManipulationMode="All"
                                                    ManipulationStarted="AudioSlider_ManipulationStarted"
                                                    ManipulationCompleted="AudioSlider_ManipulationCompleted"
                                                    Margin="0,2,0,0" Padding="0" Height="20"
                                                    Foreground="#0088cc"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding AudioPositionText}" Foreground="#AAAAAA" FontSize="11"/>
                                                <TextBlock Grid.Column="1" Text="{Binding AudioDuration}" Foreground="#AAAAAA" FontSize="11"/>
                                            </Grid>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <RichTextBlock x:Name="MsgTextBlock" TextWrapping="Wrap" Foreground="{Binding TextColor}" FontSize="16"
                                               Tag="{Binding Id}" Loaded="MsgRichText_Loaded" DataContextChanged="MsgRichText_DataContextChanged"/>
                                <!-- Дата + галочки -->
                                <Grid HorizontalAlignment="Right" Margin="0,2,0,0" Visibility="{Binding TimeVisibility}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Date}" FontSize="10" Foreground="{Binding TimeColor}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding ReadStatusText}" FontSize="10" Margin="4,0,0,0"
                                               Foreground="{Binding ReadStatusColor}" VerticalAlignment="Center"
                                               Visibility="{Binding ReadStatusVisibility}"/>
                                </Grid>
                                <!-- Реакции -->
                                <Border Visibility="{Binding ReactionsVisibility}" Background="#22FFFFFF" CornerRadius="10" Padding="6,3" Margin="0,4,0,0" HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding Reactions}" Foreground="{Binding TextColor}" FontSize="14"/>
                                </Border>
                                <!-- Inline-кнопки -->
                                <ItemsControl ItemsSource="{Binding InlineButtons}" Visibility="{Binding InlineButtonsVisibility}" Margin="0,6,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                <ItemsControl ItemsSource="{Binding Buttons}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <StackPanel Orientation="Horizontal"/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Button Content="{Binding Text}"
                                                                    Tag="{Binding}"
                                                                    Click="InlineButton_Click"
                                                                    Margin="0,0,4,0"
                                                                    Padding="10,5"
                                                                    Background="#2A6496"
                                                                    Foreground="White"
                                                                    FontSize="12"
                                                                    MinWidth="60"/>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <!-- Кнопка комментариев (только для постов каналов) -->
                                <Button Content="{Binding CommentsText}"
                                        Tag="{Binding Id}"
                                        Click="CommentsButton_Click"
                                        Visibility="{Binding CommentsVisibility}"
                                        Margin="0,6,0,0"
                                        Padding="10,5"
                                        HorizontalAlignment="Stretch"
                                        Background="#1A5276"
                                        Foreground="White"
                                        FontSize="12"/>
                            </StackPanel>
                        </Border>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            </ScrollViewer>

            <!-- Индикатор дозагрузки старых сообщений — поверх, сверху по центру -->
            <Border x:Name="OlderLoadingIndicator" Background="#CC000000" CornerRadius="16"
                    Padding="12,6" Margin="0,8,0,0"
                    VerticalAlignment="Top" HorizontalAlignment="Center"
                    IsHitTestVisible="False" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <ProgressRing x:Name="OlderProgressRing" IsActive="False"
                                  Width="18" Height="18" Foreground="White" Margin="0,0,8,0"/>
                    <TextBlock Text="Загрузка..." Foreground="White" FontSize="13" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Кнопка скролла вниз — правый нижний угол -->
            <Button x:Name="ScrollToBottomButton"
                    Click="ScrollToBottom_Click"
                    VerticalAlignment="Bottom" HorizontalAlignment="Right"
                    Margin="0,0,12,12"
                    Width="44" Height="44"
                    Background="#CC0088cc" Foreground="White"
                    FontSize="20" Padding="0"
                    Visibility="Collapsed">↓</Button>

            </Grid><!-- конец обёрточного Grid Row=1 -->

            <Grid Grid.Row="1" x:Name="LoadingIndicator" Visibility="Collapsed">
                <ProgressRing IsActive="True" Width="60" Height="60" Foreground="#0088cc" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <TextBlock Text="Загрузка..." Foreground="#888888" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,80,0,0"/>
            </Grid>

            <StackPanel x:Name="InputPanel" Grid.Row="2">
                <!-- Панель предпросмотра цитаты -->
                <Grid x:Name="ReplyPreviewPanel" Visibility="Collapsed" Background="#1A1A1A" Padding="10,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="↩ Ответить" Foreground="#0088cc" FontSize="11" FontWeight="SemiBold"/>
                        <TextBlock x:Name="ReplyPreviewText" Text="" Foreground="#AAAAAA" FontSize="12"
                                   TextTrimming="CharacterEllipsis" MaxLines="1"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="✕" Click="CancelReply_Click"
                            Background="Transparent" Foreground="#888888" FontSize="14"
                            Width="36" Height="36" Padding="0"/>
                </Grid>

                <Grid x:Name="InputBorder" Padding="10" Background="#222222">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Content="📎" Click="AttachFile_Click" Width="44" Height="40"
                        Background="Transparent" Foreground="White" FontSize="18" Padding="0"/>
                <Border x:Name="MicButton" Grid.Column="1" Width="44" Height="40"
                        Background="Transparent" CornerRadius="8"
                        PointerPressed="MicButton_PointerPressed" PointerReleased="MicButton_PointerReleased"
                        PointerExited="MicButton_PointerReleased">
                    <TextBlock Text="🎤" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <Border x:Name="MessageInputBorder" Grid.Column="2" Margin="8,0"
                        Background="#F0F2F5" BorderBrush="#D8DCE0" BorderThickness="1" CornerRadius="20" Padding="4,0">
                <TextBox x:Name="MessageInput" PlaceholderText="Сообщение..." AcceptsReturn="True" MaxHeight="100"
                         Background="Transparent" BorderThickness="0"
                         Foreground="#222222" Style="{StaticResource ChatInputStyle}"
                         Holding="MessageInput_Holding">
                    <FlyoutBase.AttachedFlyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Text="Вставить текст" Click="PasteToInput_Click"/>
                        </MenuFlyout>
                    </FlyoutBase.AttachedFlyout>
                </TextBox>
                </Border>
                <!-- Кнопка стикеров -->
                <Button x:Name="StickerButton" Grid.Column="3" Content="😊" Click="StickerButton_Click"
                        Width="44" Height="40" Background="Transparent" Foreground="White" FontSize="20" Padding="0"/>
                <Button x:Name="SendButton" Grid.Column="4" Content="➤" Click="SendMessage_Click" Width="50" Height="40" Background="#0088cc" Foreground="White"/>
            </Grid>

            <!-- Панель выбора стикеров — поверх сообщений снизу -->
            <Grid x:Name="StickerPanel" Visibility="Collapsed"
                  Grid.Row="1" VerticalAlignment="Bottom" Background="#1A1A1A" Height="280">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <!-- Вкладки стикерпаков -->
                <ScrollViewer HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled"
                              HorizontalScrollBarVisibility="Hidden" Height="48" Background="#222222">
                    <StackPanel x:Name="StickerPackTabs" Orientation="Horizontal" Padding="4"/>
                </ScrollViewer>
                <!-- Сетка стикеров -->
                <ScrollViewer Grid.Row="1" VerticalScrollMode="Enabled" VerticalScrollBarVisibility="Hidden">
                    <GridView x:Name="StickerGrid" SelectionMode="None" IsItemClickEnabled="True"
                              ItemClick="StickerGrid_ItemClick" Padding="4">
                        <GridView.ItemContainerStyle>
                            <Style TargetType="GridViewItem">
                                <Setter Property="Padding" Value="2"/>
                                <Setter Property="Margin" Value="0"/>
                            </Style>
                        </GridView.ItemContainerStyle>
                        <GridView.ItemTemplate>
                            <DataTemplate>
                                <Border Width="80" Height="80" Background="Transparent">
                                    <Image Source="{Binding Thumb}" Stretch="Uniform" Width="72" Height="72"/>
                                </Border>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>
                </ScrollViewer>
                <!-- Индикатор загрузки с прогрессом -->
                <StackPanel x:Name="StickerLoadingPanel" Grid.Row="1"
                            HorizontalAlignment="Center" VerticalAlignment="Top"
                            Margin="0,8,0,0" Visibility="Collapsed">
                    <TextBlock x:Name="StickerLoadingText"
                               Text="Загрузка..." Foreground="#888888" FontSize="13"
                               HorizontalAlignment="Center"/>
                    <TextBlock x:Name="StickerProgressText"
                               Text="" Foreground="#555555" FontSize="11"
                               HorizontalAlignment="Center" Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>

            </StackPanel>
        </Grid>


        <!-- Оверлей контактов -->
        <Grid x:Name="ContactsOverlay" Visibility="Collapsed" Background="#DD000000"
              Grid.Row="0" Grid.RowSpan="2">
            <Border Background="#222222" CornerRadius="12" Margin="20,60"
                    VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <!-- Шапка -->
                    <Grid Background="#0088cc" Padding="16,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Контакты" Foreground="White" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Content="✕" Click="ContactsOverlay_Close"
                                Background="Transparent" Foreground="White" FontSize="16"
                                Width="36" Height="36" Padding="0"/>
                    </Grid>
                    <!-- Список контактов -->
                    <Grid Grid.Row="1">
                        <ListView x:Name="ContactsListView" IsItemClickEnabled="True"
                                  ItemClick="ContactItem_Click" Background="Transparent">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="8,6" MinWidth="200">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="46"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Width="40" Height="40" HorizontalAlignment="Left">
                                            <Ellipse.Fill>
                                                <ImageBrush ImageSource="{Binding Photo}" Stretch="UniformToFill"/>
                                            </Ellipse.Fill>
                                        </Ellipse>
                                        <Ellipse Width="40" Height="40" Fill="#555555"
                                                 HorizontalAlignment="Left"
                                                 Visibility="{Binding NoPhotoVisibility}"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                                            <TextBlock Text="{Binding FullName}" Foreground="White" FontSize="15" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Username}" Foreground="#888888" FontSize="12"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <TextBlock x:Name="ContactsLoadingText" Text="Загрузка..." Foreground="#888888"
                                   FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="Collapsed"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Оверлей выбора чата для пересылки -->
        <Grid x:Name="ForwardOverlay" Visibility="Collapsed" Background="#DD000000"
              Grid.Row="0" Grid.RowSpan="2">
            <Border Background="#222222" CornerRadius="12" Margin="20,60"
                    VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <!-- Шапка -->
                    <Grid Background="#0088cc" Padding="16,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Переслать в чат" Foreground="White" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Content="✕" Click="ForwardOverlay_Close"
                                Background="Transparent" Foreground="White" FontSize="16" Width="40" Height="40" Padding="0"/>
                    </Grid>
                    <!-- Список чатов -->
                    <ListView x:Name="ForwardChatList" Grid.Row="1"
                              SelectionMode="None" IsItemClickEnabled="True"
                              ItemClick="ForwardChatList_ItemClick">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="16,8"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="40" Height="40" CornerRadius="20" Background="#555555" Margin="0,0,12,0">
                                        <Image Source="{Binding Photo}" Stretch="UniformToFill" Width="40" Height="40"/>
                                    </Border>
                                    <TextBlock Text="{Binding Title}" Foreground="White" FontSize="15"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
        </Grid>

        <!-- Полноэкранный просмотр фото -->
        <Grid x:Name="PhotoOverlay" Visibility="Collapsed" Background="#DD000000"
              Grid.Row="0" Grid.RowSpan="2">
            <ScrollViewer ZoomMode="Enabled" MinZoomFactor="1" MaxZoomFactor="5"
                          HorizontalScrollMode="Enabled" VerticalScrollMode="Enabled"
                          HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"
                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <Grid Width="{Binding ActualWidth, ElementName=PhotoOverlay}"
                      Height="{Binding ActualHeight, ElementName=PhotoOverlay}">
                    <Image x:Name="PhotoOverlayImage" Stretch="Uniform"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
            </ScrollViewer>
            <Button Content="✕" Click="PhotoOverlay_Tapped"
                    HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,8,8,0" Width="44" Height="44"
                    Background="#88000000" Foreground="White" FontSize="18" Padding="0"/>
            <TextBlock x:Name="PhotoOverlayStatus" Text="" Foreground="White"
                       VerticalAlignment="Bottom" HorizontalAlignment="Center"
                       FontSize="14" Margin="0,0,0,16"/>
        </Grid>
    </Grid>
</Page>
