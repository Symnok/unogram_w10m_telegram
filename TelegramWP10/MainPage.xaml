<Page
    x:Class="TelegramWP10.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TelegramWP10"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <Style x:Key="ChatInputStyle" TargetType="TextBox">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Grid>
                            <ScrollViewer x:Name="ContentElement" Margin="{TemplateBinding Padding}"
                                          HorizontalScrollMode="Auto" VerticalScrollMode="Auto"
                                          HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                            <TextBlock x:Name="PlaceholderTextContentPresenter"
                                       Text="{TemplateBinding PlaceholderText}"
                                       Foreground="#AAAAAA"
                                       Margin="{TemplateBinding Padding}"
                                       IsHitTestVisible="False"
                                       TextWrapping="{TemplateBinding TextWrapping}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SearchBoxStyle" TargetType="TextBox">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Grid>
                            <ScrollViewer x:Name="ContentElement" Margin="{TemplateBinding Padding}"
                                          HorizontalScrollMode="Auto" VerticalScrollMode="Auto"
                                          HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                            <TextBlock x:Name="PlaceholderTextContentPresenter"
                                       Text="{TemplateBinding PlaceholderText}"
                                       Foreground="#888888"
                                       Margin="{TemplateBinding Padding}"
                                       IsHitTestVisible="False"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid>
        <!-- Невидимый хост для воспроизведения аудио -->
        <StackPanel x:Name="AudioPlayerHost" Visibility="Collapsed" Width="0" Height="0"/>
        <Grid x:Name="StartPanel">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel x:Name="LoginPanel" Grid.Row="0" Visibility="Visible" Margin="20,20,20,10">
                <TextBlock x:Name="LoginStatus" Text="" Foreground="#0088cc" FontSize="14" Margin="0,0,0,10" TextWrapping="Wrap"/>
                <TextBox x:Name="PhoneInput" Header="{Binding [login_phone], Source={StaticResource Loc}}" PlaceholderText="+7..." InputScope="TelephoneNumber"/>
                <Button x:Name="PhoneButton" Content="{Binding [ui_next], Source={StaticResource Loc}}" Click="SendPhone_Click" HorizontalAlignment="Stretch" Margin="0,10"/>
                <TextBox x:Name="CodeInput" Header="{Binding [login_code], Source={StaticResource Loc}}" Visibility="Collapsed" Margin="0,10"/>
                <Button x:Name="CodeButton" Content="{Binding [ui_signIn], Source={StaticResource Loc}}" Click="SendCode_Click" Visibility="Collapsed" HorizontalAlignment="Stretch"/>
                <PasswordBox x:Name="PasswordInput" Header="{Binding [login_password2fa], Source={StaticResource Loc}}" Visibility="Collapsed" Margin="0,10"/>
                <Button x:Name="PasswordButton" Content="{Binding [ui_confirm], Source={StaticResource Loc}}" Click="SendPassword_Click" Visibility="Collapsed" HorizontalAlignment="Stretch"/>

                <!-- Выбор языка приложения — доступен ещё до входа в аккаунт -->
                <Button x:Name="LoginLanguageButton" Content="{Binding [menu_language], Source={StaticResource Loc}}"
                        HorizontalAlignment="Center" Margin="0,16,0,0" FontSize="12" Padding="10,5"
                        Background="#AA333333" Foreground="#AAAAAA" BorderThickness="0">
                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Text="English"    Tag="en" Click="Language_Click"/>
                            <MenuFlyoutItem Text="Русский"    Tag="ru" Click="Language_Click"/>
                            <MenuFlyoutItem Text="Українська" Tag="uk" Click="Language_Click"/>
                            <MenuFlyoutItem Text="עברית"      Tag="he" Click="Language_Click"/>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>

            <!-- Вкладки папок чатов -->
            <ScrollViewer x:Name="FolderTabsScroll" Grid.Row="1"
                          HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Hidden"
                          VerticalScrollMode="Disabled" Visibility="Collapsed">
                <StackPanel x:Name="FolderTabs" Orientation="Horizontal" Margin="4,4,4,0"/>
            </ScrollViewer>

            <!-- Строка поиска — вне ListView чтобы не терять фокус -->
            <Grid Grid.Row="2" Margin="0,4,0,8" x:Name="SearchPanel" Visibility="Collapsed">
                <Border x:Name="SearchBorder" CornerRadius="10" Padding="12,8" Margin="8,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="🔍" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#888888"/>
                        <TextBox x:Name="SearchBox" Grid.Column="1"
                                 PlaceholderText="{Binding [ui_search], Source={StaticResource Loc}}" Background="Transparent"
                                 BorderThickness="0" Foreground="White"
                                 FontSize="15" Style="{StaticResource SearchBoxStyle}"
                                 TextChanged="SearchBox_TextChanged"/>
                        <Button x:Name="SearchClearButton" Grid.Column="2" Content="✕"
                                Background="Transparent" Foreground="#888888"
                                FontSize="12" Padding="4,0" BorderThickness="0"
                                Visibility="Collapsed" Click="SearchClear_Click"/>
                    </Grid>
                </Border>
            </Grid>

            <ListView x:Name="ChatListView" Grid.Row="3" Visibility="Collapsed" SelectionMode="None" IsItemClickEnabled="True" ItemClick="ChatListView_ItemClick">
                <ListView.Header>
                    <StackPanel Background="#1A1A1A">
                        <!-- Шапка главного списка -->
                        <StackPanel x:Name="MainListHeader">
                            <Grid Margin="15,15,15,2">
                                <TextBlock x:Name="UnogramTitle" Text="Unogram" Foreground="White" FontSize="28" FontWeight="Bold" VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button x:Name="ContactsButton" Content="👤" Click="ContactsButton_Click"
                                            Background="Transparent" Foreground="#888888"
                                            FontSize="18" Padding="8,4" BorderThickness="0"/>
                                    <Button x:Name="ThemeToggleButton" Content="☀" Click="ThemeToggle_Click"
                                            Background="Transparent" Foreground="#888888"
                                            FontSize="18" Padding="8,4" BorderThickness="0"/>
                                    <Button x:Name="SettingsButton" Content="⚙" 
                                            Background="Transparent" Foreground="#888888"
                                            FontSize="18" Padding="8,4" BorderThickness="0">
                                        <Button.Flyout>
                                            <MenuFlyout>
                                                <MenuFlyoutItem x:Name="FavoritesItem" Text="⭐ Saved Messages" Click="Favorites_Click"/>
                                                <MenuFlyoutSeparator/>
                                                <MenuFlyoutItem x:Name="ClearCacheItem" Text="🗑 Clear cache" Click="ClearCache_Click"/>
                                                <MenuFlyoutItem x:Name="SoundToggleItem" Text="🔔 Sound: On" Click="SoundToggle_Click"/>
                                                <MenuFlyoutSeparator/>
                                                <MenuFlyoutItem x:Name="KeepAliveToggleItem" Text="📍 Background mode: Off" Click="KeepAliveToggle_Click"/>
                                                <MenuFlyoutItem x:Name="CatchUpToggleItem" Text="🔔 Notifications when app&#10;is closed: On" Click="CatchUpToggle_Click"/>
                                                <MenuFlyoutSeparator/>
                                                <MenuFlyoutSubItem x:Name="LanguageSubItem" Text="🌐 Language">
                                                    <MenuFlyoutItem Text="English"    Tag="en" Click="Language_Click"/>
                                                    <MenuFlyoutItem Text="Русский"    Tag="ru" Click="Language_Click"/>
                                                    <MenuFlyoutItem Text="Українська" Tag="uk" Click="Language_Click"/>
                                                    <MenuFlyoutItem Text="עברית"      Tag="he" Click="Language_Click"/>
                                                </MenuFlyoutSubItem>
                                                <MenuFlyoutSeparator/>
                                                <MenuFlyoutItem x:Name="LogoutItem" Text="🚪 Log out" Click="LogoutButton_Click"/>
                                            </MenuFlyout>
                                        </Button.Flyout>
                                    </Button>
                                </StackPanel>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="15,0,15,10">
                                <TextBlock Text="{Binding [chat_chats], Source={StaticResource Loc}}" Foreground="#888888" FontSize="13"/>
                                <TextBlock x:Name="ChatCountText" Text="0" Foreground="#888888" FontSize="13"/>
                                <ProgressRing x:Name="ConnectionProgressRing" IsActive="False"
                                              Width="14" Height="14" Foreground="#FF6666"
                                              Margin="8,0,4,0" VerticalAlignment="Center"
                                              Visibility="Collapsed"/>
                                <TextBlock x:Name="ConnectionStatusText" Text="" Foreground="#FF6666" FontSize="13" Margin="0,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                        <!-- Шапка архива -->
                        <StackPanel x:Name="ArchiveListHeader" Visibility="Collapsed">
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="ArchiveBackButton" Content="←" Click="ArchiveBack_Click"
                                        Background="Transparent" Foreground="White" FontSize="22"
                                        Padding="10,4,8,4" VerticalAlignment="Center" BorderThickness="0"/>
                                <TextBlock x:Name="ArchiveTitleText" Grid.Column="1" Text="{Binding [chat_archive], Source={StaticResource Loc}}" Foreground="White"
                                           FontSize="26" FontWeight="Bold"
                                           VerticalAlignment="Center" Margin="0,0,0,4"/>
                            </Grid>
                            <TextBlock x:Name="ArchiveChatCountText" Text="" Foreground="#888888"
                                       FontSize="13" Margin="15,0,15,10"/>
                        </StackPanel>
                        <!-- Строка "Архив" (в главном списке) -->
                        <Border x:Name="ArchiveRow" Background="#222222" Tapped="ArchiveRow_Tapped"
                                Margin="0,2,0,0" Padding="0">
                            <Grid Margin="15,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="50"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <!-- Иконка папки -->
                                <Border Width="42" Height="42" CornerRadius="21"
                                        Background="#444444" HorizontalAlignment="Left">
                                    <TextBlock Text="📁" FontSize="20"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="ArchiveRowTitle" Text="{Binding [chat_archive], Source={StaticResource Loc}}" Foreground="White"
                                               FontSize="16" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="ArchiveSubtitleText" Text="{Binding [chat_archived], Source={StaticResource Loc}}"
                                               Foreground="#888888" FontSize="13"
                                               TextTrimming="CharacterEllipsis" MaxLines="1" TextWrapping="NoWrap"/>
                                </StackPanel>
                                <Grid Grid.Column="2" VerticalAlignment="Center" Margin="4,0,0,0">
                                    <!-- Бейдж непрочитанных -->
                                    <Border x:Name="ArchiveUnreadBadge" Background="#888888"
                                            CornerRadius="10" MinWidth="20" Height="20"
                                            Padding="5,0" HorizontalAlignment="Right"
                                            Visibility="Collapsed">
                                        <TextBlock x:Name="ArchiveUnreadText" Text="0"
                                                   Foreground="White" FontSize="12"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <!-- Стрелка (когда нет непрочитанных) -->
                                    <TextBlock x:Name="ArchiveArrow" Text="›" Foreground="#888888"
                                               FontSize="20" HorizontalAlignment="Right"
                                               VerticalAlignment="Center" Margin="0,0,2,0"/>
                                </Grid>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ListView.Header>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Holding="ChatItem_Holding">
                            <FlyoutBase.AttachedFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem x:Name="MenuPinChat" Text="{Binding [msgmenu_pin], Source={StaticResource Loc}}" Click="PinChat_Click"/>
                                    <MenuFlyoutItem x:Name="MenuMarkUnread" Text="{Binding [chatmenu_unread], Source={StaticResource Loc}}" Click="MarkUnread_Click"/>
                                    <MenuFlyoutItem x:Name="MenuArchiveChat" Text="{Binding [chatmenu_archive], Source={StaticResource Loc}}" Click="ArchiveChat_Click"/>
                                    <MenuFlyoutItem Text="{Binding [chatmenu_deleteChat], Source={StaticResource Loc}}" Click="DeleteChat_Click"/>
                                </MenuFlyout>
                            </FlyoutBase.AttachedFlyout>
                            <StackPanel>
                                <Grid Margin="12,8,12,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- Круглая аватарка через Ellipse -->
                                    <Grid Width="60" VerticalAlignment="Top">
                                        <Ellipse Width="50" Height="50" HorizontalAlignment="Left">
                                            <Ellipse.Fill>
                                                <ImageBrush ImageSource="{Binding Photo}" Stretch="UniformToFill"/>
                                            </Ellipse.Fill>
                                        </Ellipse>
                                        <Ellipse Width="50" Height="50" HorizontalAlignment="Left"
                                                 Fill="{Binding AvatarColor}" Visibility="{Binding NoPhotoVisibility}"/>
                                        <TextBlock Text="{Binding AvatarInitials}" Width="50" Height="50"
                                                   HorizontalAlignment="Left" TextAlignment="Center"
                                                   Foreground="White" FontSize="19" FontWeight="SemiBold"
                                                   Margin="0,15,0,0"
                                                   Visibility="{Binding NoPhotoVisibility}"/>
                                        <Ellipse Width="14" Height="14" Fill="#22C55E"
                                                 HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                 Margin="0,0,2,0"
                                                 Visibility="{Binding OnlineVisibility}"/>
                                    </Grid>
                                    <!-- Текстовый блок -->
                                    <Grid Grid.Column="1" Margin="5,0,0,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <!-- Строка 1: название + время -->
                                        <Grid Grid.Row="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="📌 " FontSize="12" Foreground="#888888"
                                                           Visibility="{Binding PinVisibility}" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Title}" Foreground="{Binding TitleColor}" FontSize="16" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding LastMessageTime}" Foreground="{Binding TimeColor}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                        </Grid>
                                        <!-- Строка 2: последнее сообщение + бейдж -->
                                        <Grid Grid.Row="1" Margin="0,2,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding LastMessage}" Foreground="{Binding SubtitleColor}" FontSize="13" TextTrimming="CharacterEllipsis" MaxLines="1" TextWrapping="NoWrap"/>
                                            <TextBlock Grid.Column="1" Text="{Binding StatusText}" Foreground="{Binding StatusColor}" FontSize="13"
                                                       VerticalAlignment="Center" Margin="6,0,0,0"
                                                       Visibility="{Binding StatusVisibility}"/>
                                            <Border Grid.Column="1" Background="#0088cc" CornerRadius="10" MinWidth="20" Height="20"
                                                    VerticalAlignment="Center" Margin="6,0,0,0"
                                                    Visibility="{Binding UnreadVisibility}" Padding="4,0">
                                                <TextBlock Text="{Binding UnreadText}" Foreground="White" FontSize="11"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <Border Grid.Column="1" Background="Transparent" BorderBrush="#0088cc" BorderThickness="2"
                                                    CornerRadius="7" Width="14" Height="14"
                                                    VerticalAlignment="Center" Margin="6,0,0,0"
                                                    Visibility="{Binding MarkedUnreadVisibility}"/>
                                        </Grid>
                                    </Grid>
                                </Grid>
                                <!-- Разделитель -->
                                <Border Height="0.5" Background="#33888888" Margin="72,0,0,0"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- Результаты поиска -->
            <!-- Результаты поиска — ScrollViewer с двумя секциями -->
            <!-- Результаты поиска — один ListView с секциями через Header/Footer -->
            <ListView x:Name="SearchResultsView" Grid.Row="3" Visibility="Collapsed"
                      SelectionMode="None" IsItemClickEnabled="True" ItemClick="SearchResult_ItemClick">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="0"/>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <!-- Заголовок секции -->
                            <TextBlock Text="{Binding Title}" Foreground="#888888"
                                       FontSize="12" FontWeight="SemiBold" Margin="12,10,12,4"
                                       Visibility="{Binding HeaderVisibility}"/>
                            <!-- Разделитель -->
                            <Rectangle Height="1" Fill="#333333" Margin="0,6,0,6"
                                       Visibility="{Binding DividerVisibility}"/>
                            <!-- Обычный элемент -->
                            <Grid Padding="12,8" Visibility="{Binding ItemVisibility}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="44"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Ellipse Width="40" Height="40" Fill="{Binding AvatarColor}" Visibility="{Binding NoPhotoVisibility}"/>
                                <TextBlock Text="{Binding AvatarInitials}" Width="40" Height="40"
                                           TextAlignment="Center" Foreground="White" FontSize="15" FontWeight="SemiBold"
                                           Margin="0,11,0,0" Visibility="{Binding NoPhotoVisibility}"/>
                                <Ellipse Width="40" Height="40">
                                    <Ellipse.Fill>
                                        <ImageBrush ImageSource="{Binding Photo}" Stretch="UniformToFill"/>
                                    </Ellipse.Fill>
                                </Ellipse>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" Foreground="{Binding TitleColor}" FontSize="15" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Subtitle}" Foreground="#888888" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding DateText}" Foreground="#666666" FontSize="11"
                                               Visibility="{Binding DateVisibility}"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,4">
                <TextBlock x:Name="ProxyStatusText" Text="" Foreground="#555555"
                           FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"
                           TextTrimming="CharacterEllipsis" Visibility="Collapsed"/>
                <Button x:Name="ProxySettingsButton" Content="{Binding [proxy_title], Source={StaticResource Loc}}" Click="ProxySettingsButton_Click"
                        FontSize="11" Padding="8,4" Background="#AA333333" Foreground="#AAAAAA"/>
            </StackPanel>
        </Grid>

        <!-- Popup настроек прокси -->
        <Popup x:Name="ProxyPopup" IsLightDismissEnabled="True">
            <Border Background="#1E1E1E" BorderBrush="#444" BorderThickness="1"
                    Width="320" MaxHeight="480" Padding="16" CornerRadius="8">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="{Binding [proxy_settings], Source={StaticResource Loc}}" Foreground="White" FontSize="16"
                                   FontWeight="SemiBold" Margin="0,0,0,12"/>

                        <!-- Режим -->
                        <RadioButton x:Name="ProxyModeNone" Content="{Binding [proxy_none], Source={StaticResource Loc}}"
                                     GroupName="ProxyMode" Foreground="#CCCCCC" Checked="ProxyMode_Checked"/>
                        <RadioButton x:Name="ProxyModeAuto" Content="{Binding [proxy_auto], Source={StaticResource Loc}}"
                                     GroupName="ProxyMode" Foreground="#CCCCCC" Margin="0,4,0,0" Checked="ProxyMode_Checked"/>
                        <RadioButton x:Name="ProxyModeMtproto" Content="MTProto"
                                     GroupName="ProxyMode" Foreground="#CCCCCC" Margin="0,4,0,0" Checked="ProxyMode_Checked"/>
                        <RadioButton x:Name="ProxyModeHttp" Content="HTTP"
                                     GroupName="ProxyMode" Foreground="#CCCCCC" Margin="0,4,0,0" Checked="ProxyMode_Checked"/>
                        <RadioButton x:Name="ProxyModeSocks" Content="SOCKS5"
                                     GroupName="ProxyMode" Foreground="#CCCCCC" Margin="0,4,0,12" Checked="ProxyMode_Checked"/>

                        <!-- MTProto поля -->
                        <StackPanel x:Name="MtprotoFields" Visibility="Collapsed">
                            <TextBox x:Name="MtpHost" Header="{Binding [proxy_host], Source={StaticResource Loc}}" PlaceholderText="example.com" Margin="0,0,0,6"/>
                            <TextBox x:Name="MtpPort" Header="{Binding [proxy_port], Source={StaticResource Loc}}" PlaceholderText="443" InputScope="Number" Margin="0,0,0,6"/>
                            <TextBox x:Name="MtpSecret" Header="{Binding [proxy_secret], Source={StaticResource Loc}}" PlaceholderText="dd..." Margin="0,0,0,12"/>
                        </StackPanel>

                        <!-- HTTP поля -->
                        <StackPanel x:Name="HttpFields" Visibility="Collapsed">
                            <TextBox x:Name="HttpHost" Header="{Binding [proxy_host], Source={StaticResource Loc}}" PlaceholderText="example.com" Margin="0,0,0,6"/>
                            <TextBox x:Name="HttpPort" Header="{Binding [proxy_port], Source={StaticResource Loc}}" PlaceholderText="8080" InputScope="Number" Margin="0,0,0,12"/>
                        </StackPanel>

                        <!-- SOCKS5 поля -->
                        <StackPanel x:Name="SocksFields" Visibility="Collapsed">
                            <TextBox x:Name="SocksHost" Header="{Binding [proxy_host], Source={StaticResource Loc}}" PlaceholderText="example.com" Margin="0,0,0,6"/>
                            <TextBox x:Name="SocksPort" Header="{Binding [proxy_port], Source={StaticResource Loc}}" PlaceholderText="1080" InputScope="Number" Margin="0,0,0,6"/>
                            <TextBox x:Name="SocksUser" Header="{Binding [proxy_login], Source={StaticResource Loc}}" PlaceholderText="" Margin="0,0,0,6"/>
                            <PasswordBox x:Name="SocksPass" Header="{Binding [proxy_password], Source={StaticResource Loc}}" Margin="0,0,0,12"/>
                        </StackPanel>

                        <Button Content="{Binding [ui_apply], Source={StaticResource Loc}}" Click="ProxyApply_Click"
                                HorizontalAlignment="Stretch" Background="#0088cc" Foreground="White"/>
                        <Button Content="{Binding [ui_cancel], Source={StaticResource Loc}}" Click="ProxyCancel_Click"
                                HorizontalAlignment="Stretch" Background="Transparent" Foreground="#888888" Margin="0,6,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Popup>

        <Grid x:Name="MessagesPanel" Visibility="Collapsed" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid x:Name="ChatHeader" Background="#0088cc" Padding="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" x:Name="BackButton" Content="←" Click="BackButton_Click" Foreground="White" Background="Transparent" FontSize="20"/>
                <!-- Аватарка + имя — кликабельны для открытия профиля -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Tapped="ChatHeaderProfile_Tapped" VerticalAlignment="Center">
                    <Grid Width="36" Height="36" VerticalAlignment="Center" Margin="6,0,0,0">
                        <Ellipse x:Name="ChatHeaderAvatarBorder" Width="36" Height="36" Fill="#555555"/>
                        <TextBlock x:Name="ChatHeaderAvatarInitials" Text="" Width="36" Height="36"
                                   TextAlignment="Center" Foreground="White" FontSize="14" FontWeight="SemiBold"
                                   Margin="0,9,0,0"/>
                        <Ellipse x:Name="ChatHeaderAvatarEllipse" Width="36" Height="36">
                            <Ellipse.Fill>
                                <ImageBrush x:Name="ChatHeaderAvatarBrush" Stretch="UniformToFill"/>
                            </Ellipse.Fill>
                        </Ellipse>
                    </Grid>
                    <StackPanel VerticalAlignment="Center" Margin="10,0">
                        <TextBlock x:Name="CurrentChatTitle" Text="{Binding [chat_chat], Source={StaticResource Loc}}" Foreground="White" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock x:Name="CurrentChatStatus" Text="" Foreground="#CCE8FF" FontSize="13"/>
                    </StackPanel>
                </StackPanel>
                <Button Grid.Column="2" x:Name="ChatSearchButton" Content="🔍" Click="ChatSearchButton_Click"
                        Foreground="White" Background="Transparent" FontSize="16" VerticalAlignment="Center"/>
            </Grid>

            <!-- Поиск по текущей переписке — та же ячейка, что и шапка, поверх неё -->
            <Grid x:Name="ChatSearchBar" Grid.Row="0" Background="#0088cc" Padding="10" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" x:Name="ChatSearchCloseButton" Content="←" Click="ChatSearchClose_Click" Foreground="White" Background="Transparent" FontSize="20"/>
                <TextBox Grid.Column="1" x:Name="ChatSearchBox"
                         PlaceholderText="{Binding [ui_search], Source={StaticResource Loc}}"
                         Background="Transparent" BorderThickness="0" Foreground="White"
                         FontSize="15" Style="{StaticResource SearchBoxStyle}"
                         Margin="8,0" VerticalAlignment="Center"
                         TextChanged="ChatSearchBox_TextChanged"/>
                <TextBlock Grid.Column="2" x:Name="ChatSearchCounter" Text="" Foreground="#CCE8FF" FontSize="13"
                           VerticalAlignment="Center" Margin="0,0,4,0"/>
                <Button Grid.Column="3" x:Name="ChatSearchUpButton" Content="⌃" Click="ChatSearchUp_Click"
                        Foreground="White" Background="Transparent" FontSize="16" VerticalAlignment="Center" Padding="8,0"/>
                <Button Grid.Column="4" x:Name="ChatSearchDownButton" Content="⌄" Click="ChatSearchDown_Click"
                        Foreground="White" Background="Transparent" FontSize="16" VerticalAlignment="Center" Padding="8,0"/>
            </Grid>

            <!-- Закреплённое сообщение -->
            <Button x:Name="PinnedMessageBar" Grid.Row="1" Click="PinnedMessage_Click"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                    Background="#CC1F3A52" Foreground="White" Padding="10,6"
                    BorderThickness="0" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Rectangle x:Name="PinnedAccentLine" Grid.Column="0" Fill="#2AABEE" Width="3" RadiusX="2" RadiusY="2"/>
                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                        <TextBlock x:Name="PinnedLabel" Text="{Binding [chat_pinnedMessage], Source={StaticResource Loc}}" Foreground="#2AABEE" FontSize="11" FontWeight="SemiBold"/>
                        <TextBlock x:Name="PinnedMessageText" Text="" Foreground="White" FontSize="13"
                                   TextTrimming="CharacterEllipsis" MaxLines="1"/>
                    </StackPanel>
                </Grid>
            </Button>

            <!-- Область сообщений: ScrollViewer + оверлеи в одном Grid -->
            <Grid Grid.Row="2">
            <ScrollViewer x:Name="MessagesScrollViewer"
                          VerticalScrollMode="Enabled" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled"
                          ViewChanged="MessagesScrollViewer_ViewChanged">
            <ListView x:Name="MessagesListView" SelectionMode="None" Padding="10,10,10,12" IsItemClickEnabled="True" ItemClick="MessagesListView_ItemClick" Visibility="Collapsed">
                <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsStackPanel x:Name="MessagesStackPanel" ItemsUpdatingScrollMode="KeepLastItemInView"/>
                    </ItemsPanelTemplate>
                </ListView.ItemsPanel>
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="0"/>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <!-- Разделитель дат -->
                            <Border Visibility="{Binding SeparatorVisibility}" HorizontalAlignment="Stretch" Margin="0,6,0,6">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Border Background="{Binding SeparatorBackground}" CornerRadius="10" Padding="12,4">
                                        <TextBlock Text="{Binding SeparatorLabel}" FontSize="12" Foreground="{Binding SeparatorTextColor}" FontWeight="SemiBold"/>
                                    </Border>
                                </StackPanel>
                            </Border>
                            <!-- Пузырь сообщения (+ аватарка отправителя в группах) -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="{Binding Alignment}"
                                        VerticalAlignment="Bottom" Margin="{Binding GroupMargin}"
                                        Visibility="{Binding MessageVisibility}">
                                <Grid Width="28" Height="28" Margin="0,0,6,0" VerticalAlignment="Bottom"
                                      Visibility="{Binding SenderAvatarVisibility}">
                                    <Ellipse Fill="{Binding SenderAvatarColor}" Visibility="{Binding SenderAvatarPlaceholderVisibility}"/>
                                    <TextBlock Text="{Binding SenderAvatarInitials}" Width="28" Height="28"
                                               TextAlignment="Center" Foreground="White" FontSize="11" FontWeight="SemiBold"
                                               Margin="0,7,0,0" Visibility="{Binding SenderAvatarPlaceholderVisibility}"/>
                                    <Ellipse Width="28" Height="28">
                                        <Ellipse.Fill>
                                            <ImageBrush ImageSource="{Binding SenderPhoto}" Stretch="UniformToFill"/>
                                        </Ellipse.Fill>
                                    </Ellipse>
                                </Grid>
                            <Border Background="{Binding BubbleBackground}" Padding="{Binding BubblePadding}" CornerRadius="{Binding BubbleCornerRadius}"
                                    Holding="MessageBubble_Holding">
                            <FlyoutBase.AttachedFlyout>
                                <MenuFlyout>
                                    <!-- Быстрые реакции -->
                                    <MenuFlyoutItem Text="{Binding [react_like], Source={StaticResource Loc}}" Click="React_Click" Tag="👍"/>
                                    <MenuFlyoutItem Text="{Binding [react_heart], Source={StaticResource Loc}}" Click="React_Click" Tag="❤"/>
                                    <MenuFlyoutItem Text="{Binding [react_fire], Source={StaticResource Loc}}" Click="React_Click" Tag="🔥"/>
                                    <MenuFlyoutItem Text="{Binding [react_laugh], Source={StaticResource Loc}}" Click="React_Click" Tag="🤣"/>
                                    <MenuFlyoutItem Text="{Binding [react_sad], Source={StaticResource Loc}}" Click="React_Click" Tag="😢"/>
                                    <MenuFlyoutItem Text="{Binding [react_dislike], Source={StaticResource Loc}}" Click="React_Click" Tag="👎"/>
                                    <MenuFlyoutSeparator/>
                                    <MenuFlyoutItem Text="{Binding [msgmenu_reply], Source={StaticResource Loc}}" Click="ReplyMessage_Click"/>
                                    <MenuFlyoutItem Text="{Binding [msgmenu_forward], Source={StaticResource Loc}}" Click="ForwardMessage_Click"/>
                                    <MenuFlyoutItem Text="{Binding [msgmenu_copy], Source={StaticResource Loc}}" Click="CopyMessage_Click"/>
                                    <MenuFlyoutItem x:Name="MenuEdit" Text="{Binding [msgmenu_edit], Source={StaticResource Loc}}" Click="EditMessage_Click"/>
                                    <MenuFlyoutItem x:Name="MenuPin" Text="{Binding [msgmenu_pin], Source={StaticResource Loc}}" Click="PinMessage_Click"/>
                                    <MenuFlyoutItem x:Name="MenuMention" Text="{Binding [msgmenu_mention], Source={StaticResource Loc}}" Click="OpenMention_Click" Visibility="Collapsed"/>
                                    <MenuFlyoutItem x:Name="MenuSaveVideo" Text="{Binding [msgmenu_save], Source={StaticResource Loc}}" Click="SaveVideoMessage_Click" Visibility="Collapsed"/>
                                    <MenuFlyoutItem x:Name="MenuDeleteSelf" Text="{Binding [msgmenu_delete], Source={StaticResource Loc}}" Click="DeleteMessageSelf_Click"/>
                                    <MenuFlyoutItem x:Name="MenuDeleteAll" Text="{Binding [msgmenu_deleteAll], Source={StaticResource Loc}}" Click="DeleteMessageAll_Click"/>
                                </MenuFlyout>
                            </FlyoutBase.AttachedFlyout>
                            <StackPanel MaxWidth="260">
                                <!-- Ник отправителя (только входящие в группах) -->
                                <TextBlock Text="{Binding SenderName}" FontSize="12" FontWeight="Bold"
                                           Foreground="{Binding SenderColor}"
                                           Visibility="{Binding SenderNameVisibility}"
                                           Margin="0,0,0,3"/>

                                <!-- Переслано от -->
                                <StackPanel Orientation="Horizontal" Visibility="{Binding ForwardedVisibility}" Margin="0,0,0,4">
                                    <TextBlock Text="↪ " Foreground="#7EC8E3" FontSize="12"/>
                                    <TextBlock Text="{Binding ForwardedFrom}" Foreground="#7EC8E3" FontSize="12"
                                               FontStyle="Italic" TextTrimming="CharacterEllipsis" MaxWidth="220"/>
                                </StackPanel>

                                <!-- Цитата -->
                                <Border Background="{Binding ReplyBackground}" BorderBrush="{Binding ReplyBorderBrush}" BorderThickness="2,0,0,0" Margin="0,0,0,5" Padding="5,2" Visibility="{Binding ReplyVisibility}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding ReplyAuthor}" FontSize="11" FontWeight="Bold"
                                                   Foreground="{Binding ReplyAuthorColor}" Visibility="{Binding ReplyAuthorVisibility}"/>
                                        <TextBlock Text="{Binding ReplyToText}" FontSize="12" Foreground="{Binding ReplyTextColor}" TextTrimming="CharacterEllipsis" MaxLines="2"/>
                                    </StackPanel>
                                </Border>

                                <!-- Фото / Видео (превью + иконка воспроизведения) -->
                                <Grid Visibility="{Binding PhotoVisibility}" Margin="0,0,0,5">
                                    <Image Source="{Binding AttachedPhoto}" Stretch="Uniform" MaxWidth="{Binding PhotoMaxWidth}" MaxHeight="{Binding PhotoMaxWidth}"
                                           Tapped="PhotoImage_Tapped"/>
                                    <TextBlock Text="▶" Foreground="White" FontSize="40" VerticalAlignment="Center" HorizontalAlignment="Center"
                                               Visibility="{Binding VideoIconVisibility}" Opacity="0.8" IsHitTestVisible="False"/>
                                    <Border VerticalAlignment="Center" HorizontalAlignment="Center"
                                            Background="#88000000" Padding="6,2"
                                            Visibility="{Binding VideoProgressVisibility}">
                                        <TextBlock Text="{Binding VideoDownloadProgress}" Foreground="White"
                                                   FontSize="14" FontWeight="Bold" IsHitTestVisible="False"/>
                                    </Border>
                                </Grid>

                                <!-- GIF: MediaElement авто-воспроизведение (без превью) -->
                                <Grid Visibility="{Binding GifPlayerVisibility}" Margin="0,0,0,5"
                                      MaxWidth="250" Tapped="PhotoImage_Tapped">
                                    <MediaElement x:Name="GifPlayer"
                                                  Source="{Binding GifSource}"
                                                  AutoPlay="True" IsLooping="True"
                                                  IsMuted="True" AreTransportControlsEnabled="False"
                                                  Stretch="Uniform" MaxWidth="250"/>
                                    <!-- Прогресс скачивания GIF -->
                                    <Border VerticalAlignment="Center" HorizontalAlignment="Center"
                                            Background="#88000000" Padding="6,2"
                                            Visibility="{Binding VideoProgressVisibility}">
                                        <TextBlock Text="{Binding VideoDownloadProgress}" Foreground="White"
                                                   FontSize="14" FontWeight="Bold" IsHitTestVisible="False"/>
                                    </Border>
                                </Grid>

                                <!-- Документ -->
                                <!-- Опрос -->
                                <StackPanel Visibility="{Binding PollVisibility}" Margin="0,0,0,5" MinWidth="200">
                                    <TextBlock Text="{Binding PollType}" Foreground="#888888" FontSize="11" Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding PollQuestion}" Foreground="{Binding TextColor}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                    <ItemsControl ItemsSource="{Binding PollOptions}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Tag="{Binding}" Click="PollOption_Click"
                                                        HorizontalAlignment="Stretch" Margin="0,0,0,4"
                                                        Background="Transparent" BorderThickness="0" Padding="0">
                                                <StackPanel>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Text}" Foreground="{Binding TextColor}" FontSize="13" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding PercentText}" Foreground="{Binding TextColor}" Opacity="0.6" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                                    </Grid>
                                                    <!-- Полоска прогресса -->
                                                    <ProgressBar Value="{Binding Percent}" Maximum="100"
                                                                 Foreground="{Binding BarColor}"
                                                                 Background="#33FFFFFF"
                                                                 Height="4" Margin="0,3,0,0"/>
                                                    <TextBlock Text="{Binding VoteText}" Foreground="#888888" FontSize="11" Margin="0,2,0,0"/>
                                                </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <!-- Документ -->
                                <Border Visibility="{Binding DocumentVisibility}" Background="#22FFFFFF" CornerRadius="6" Padding="8,6" Margin="0,0,0,5">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="📄" FontSize="28" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DocumentName}" Foreground="{Binding TextColor}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding DocumentSize}" Foreground="#AAAAAA" FontSize="11"/>
                                            </StackPanel>
                                        </Grid>
                                        <Button Content="{Binding DownloadStatus}" Tag="{Binding Id}" Click="DocumentButton_Click"
                                                Margin="0,6,0,0" HorizontalAlignment="Stretch"
                                                Background="#0088cc" Foreground="White" FontSize="12" Padding="6,4"/>
                                    </StackPanel>
                                </Border>

                                <!-- Аудио -->
                                <Border Visibility="{Binding AudioVisibility}" Background="#22FFFFFF" CornerRadius="6" Padding="8,6" Margin="0,0,0,5">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Content="{Binding AudioPlayStatus}" Tag="{Binding Id}" Click="AudioButton_Click"
                                                Width="40" Height="40" Background="#0088cc" Foreground="White" FontSize="16"
                                                Padding="0" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding AudioTitle}" Foreground="White" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <Slider Tag="{Binding Id}" Minimum="0" Maximum="{Binding AudioDurationSeconds}"
                                                    Value="{Binding AudioPosition, Mode=OneWay}"
                                                    ManipulationMode="All"
                                                    ManipulationStarted="AudioSlider_ManipulationStarted"
                                                    ManipulationCompleted="AudioSlider_ManipulationCompleted"
                                                    Margin="0,2,0,0" Padding="0" Height="20"
                                                    Foreground="#0088cc"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding AudioPositionText}" Foreground="#AAAAAA" FontSize="11"/>
                                                <TextBlock Grid.Column="1" Text="{Binding AudioDuration}" Foreground="#AAAAAA" FontSize="11"/>
                                            </Grid>
                                        </StackPanel>
                                        <Button Grid.Column="2" Content="💾" Tag="{Binding Id}" Click="SaveAudio_Click"
                                                Width="32" Height="32" Background="Transparent" Foreground="White" FontSize="14"
                                                Padding="0" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <RichTextBlock x:Name="MsgTextBlock" TextWrapping="Wrap" Foreground="{Binding TextColor}" FontSize="16"
                                               Tag="{Binding Id}" Loaded="MsgRichText_Loaded" DataContextChanged="MsgRichText_DataContextChanged"/>
                                <!-- Дата + галочки -->
                                <Grid HorizontalAlignment="Right" Margin="0,2,0,0" Visibility="{Binding TimeVisibility}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding [label_edited], Source={StaticResource Loc}}" FontSize="10"
                                               Foreground="{Binding TimeColor}" VerticalAlignment="Center" Margin="0,0,4,0"
                                               Visibility="{Binding EditedVisibility}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Date}" FontSize="10" Foreground="{Binding TimeColor}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{Binding ReadStatusText}" FontSize="10" Margin="4,0,0,0"
                                               Foreground="{Binding ReadStatusColor}" VerticalAlignment="Center"
                                               Visibility="{Binding ReadStatusVisibility}"/>
                                </Grid>
                                <!-- Link Preview -->
                                <Border Visibility="{Binding LinkPreviewVisibility}"
                                        Background="#22FFFFFF" CornerRadius="6"
                                        Margin="0,6,0,2" Padding="0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="3"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Rectangle Grid.Column="0" Fill="#2AABEE" RadiusX="2" RadiusY="2"/>
                                        <StackPanel Grid.Column="1" Margin="8,6,6,6">
                                            <TextBlock Text="{Binding LinkPreviewSiteName}"
                                                       Foreground="#2AABEE" FontSize="12" FontWeight="SemiBold"
                                                       Visibility="{Binding LinkPreviewSiteVisibility}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding LinkPreviewTitle}"
                                                       Foreground="White" FontSize="13" FontWeight="SemiBold"
                                                       Visibility="{Binding LinkPreviewTitleVisibility}"
                                                       TextWrapping="Wrap" MaxLines="2"/>
                                            <TextBlock Text="{Binding LinkPreviewDescription}"
                                                       Foreground="#CCCCCC" FontSize="12"
                                                       Visibility="{Binding LinkPreviewDescriptionVisibility}"
                                                       TextWrapping="Wrap" MaxLines="3"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <!-- Реакции -->
                                <Border Visibility="{Binding ReactionsVisibility}" Background="#22FFFFFF" CornerRadius="10" Padding="6,3" Margin="0,4,0,0" HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding Reactions}" Foreground="{Binding TextColor}" FontSize="14"/>
                                </Border>
                                <!-- Inline-кнопки -->
                                <ItemsControl ItemsSource="{Binding InlineButtons}" Visibility="{Binding InlineButtonsVisibility}" Margin="0,6,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                <ItemsControl ItemsSource="{Binding Buttons}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <StackPanel Orientation="Horizontal"/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Button Content="{Binding Text}"
                                                                    Tag="{Binding}"
                                                                    Click="InlineButton_Click"
                                                                    Margin="0,0,4,0"
                                                                    Padding="10,5"
                                                                    Background="#2A6496"
                                                                    Foreground="White"
                                                                    FontSize="12"
                                                                    MinWidth="60"/>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <!-- Кнопка комментариев (только для постов каналов) -->
                                <Button Content="{Binding CommentsText}"
                                        Tag="{Binding Id}"
                                        Click="CommentsButton_Click"
                                        Visibility="{Binding CommentsVisibility}"
                                        Margin="0,6,0,0"
                                        Padding="10,5"
                                        HorizontalAlignment="Stretch"
                                        Background="#1A5276"
                                        Foreground="White"
                                        FontSize="12"/>
                            </StackPanel>
                        </Border>
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            </ScrollViewer>

            <!-- Результаты поиска внутри чата — та же визуальная стилистика, что и в главном окне -->
            <ListView x:Name="ChatSearchResultsView" SelectionMode="None" IsItemClickEnabled="True"
                      ItemClick="ChatSearchResult_ItemClick" Visibility="Collapsed"
                      Background="#111111" VerticalAlignment="Stretch">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="0"/>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="12,10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="{Binding Subtitle}" Foreground="{Binding TitleColor}" FontSize="14"
                                       TextTrimming="CharacterEllipsis" TextWrapping="Wrap" MaxLines="2"/>
                            <TextBlock Grid.Row="1" Text="{Binding DateText}" Foreground="#888888" FontSize="11" Margin="0,4,0,0"/>
                            <Rectangle Grid.Row="1" VerticalAlignment="Bottom" Height="1" Fill="#262626" Margin="0,10,0,-10"/>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- Индикатор дозагрузки старых сообщений — поверх, сверху по центру -->
            <Border x:Name="OlderLoadingIndicator" Background="#CC000000" CornerRadius="16"
                    Padding="12,6" Margin="0,8,0,0"
                    VerticalAlignment="Top" HorizontalAlignment="Center"
                    IsHitTestVisible="False" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <ProgressRing x:Name="OlderProgressRing" IsActive="False"
                                  Width="18" Height="18" Foreground="White" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding [ui_loading], Source={StaticResource Loc}}" Foreground="White" FontSize="13" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Плашка нехватки памяти -->
            <Border x:Name="MemoryWarningBanner" Background="#CCCC2200" CornerRadius="10"
                    Padding="12,6" Margin="0,48,0,0"
                    VerticalAlignment="Top" HorizontalAlignment="Center"
                    IsHitTestVisible="False" Visibility="Collapsed">
                <TextBlock Text="{Binding [err_outOfMemory], Source={StaticResource Loc}}" Foreground="White" FontSize="12" FontWeight="SemiBold"/>
            </Border>

            <!-- Кнопка скролла вниз — правый нижний угол -->
            <Button x:Name="ScrollToBottomButton"
                    Click="ScrollToBottom_Click"
                    VerticalAlignment="Bottom" HorizontalAlignment="Right"
                    Margin="0,0,12,12"
                    Width="44" Height="44"
                    Background="#CC0088cc" Foreground="White"
                    FontSize="20" Padding="0"
                    Visibility="Collapsed">↓</Button>

            <!-- Оверлей выбора чата для пересылки -->
            <Grid x:Name="ForwardChatOverlay" Visibility="Collapsed"
                  Background="#CC000000" Grid.Row="2">
                <Border Background="#1C1C1E" CornerRadius="16" Margin="10,40,10,40">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Padding="16,12" Background="#2A2A2E">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding [chat_forwardToDots], Source={StaticResource Loc}}" Foreground="White" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Content="✕" Click="ForwardChatOverlay_Close"
                                    Background="Transparent" Foreground="White" FontSize="18" Padding="8,0"/>
                        </Grid>
                        <ListView x:Name="ForwardChatList" Grid.Row="1"
                                  SelectionMode="None" IsItemClickEnabled="True"
                                  ItemClick="ForwardChatList_ItemClick">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="0"/>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="12,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="44"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Width="40" Height="40" Fill="{Binding AvatarColor}" Visibility="{Binding NoPhotoVisibility}"/>
                                        <TextBlock Text="{Binding AvatarInitials}" Width="40" Height="40"
                                                   TextAlignment="Center" Foreground="White" FontSize="15" FontWeight="SemiBold"
                                                   Margin="0,11,0,0" Visibility="{Binding NoPhotoVisibility}"/>
                                        <Ellipse Width="40" Height="40">
                                            <Ellipse.Fill>
                                                <ImageBrush ImageSource="{Binding Photo}" Stretch="UniformToFill"/>
                                            </Ellipse.Fill>
                                        </Ellipse>
                                        <TextBlock Grid.Column="1" Text="{Binding Title}" Foreground="White"
                                                   FontSize="16" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>
            </Grid>

            <!-- Оверлей профиля собеседника -->
            <Grid x:Name="ProfileOverlay" Visibility="Collapsed"
                  Background="#CC000000" Grid.Row="2" Tapped="ProfileOverlay_Tapped">
                <Border Background="#1C1C1E" CornerRadius="16" Margin="20,60,20,60"
                        VerticalAlignment="Top" MaxHeight="500">
                    <ScrollViewer VerticalScrollMode="Auto" VerticalScrollBarVisibility="Hidden">
                        <StackPanel Padding="20">
                            <!-- Аватарка -->
                            <Grid Width="80" Height="80" HorizontalAlignment="Center" Margin="0,0,0,12">
                                <Ellipse Width="80" Height="80" x:Name="ProfileAvatarPlaceholder" Fill="#555555"/>
                                <TextBlock x:Name="ProfileAvatarInitials" Text="" Width="80" Height="80"
                                           TextAlignment="Center" Foreground="White" FontSize="30" FontWeight="SemiBold"
                                           Margin="0,24,0,0"/>
                                <Ellipse Width="80" Height="80" x:Name="ProfileAvatarEllipse">
                                    <Ellipse.Fill>
                                        <ImageBrush x:Name="ProfileAvatarBrush" Stretch="UniformToFill"/>
                                    </Ellipse.Fill>
                                </Ellipse>
                            </Grid>
                            <!-- Имя -->
                            <TextBlock x:Name="ProfileName" Text="" Foreground="White"
                                       FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"
                                       TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,4"/>
                            <!-- Ник -->
                            <TextBlock x:Name="ProfileUsername" Text="" Foreground="#2AABEE"
                                       FontSize="14" HorizontalAlignment="Center" Margin="0,0,0,16"
                                       Visibility="Collapsed"/>
                            <!-- Разделитель -->
                            <Rectangle Height="1" Fill="#333333" Margin="0,0,0,12"/>
                            <!-- Телефон -->
                            <StackPanel x:Name="ProfilePhonePanel" Visibility="Collapsed" Margin="0,0,0,12">
                                <TextBlock Text="{Binding [login_phone], Source={StaticResource Loc}}" Foreground="#888888" FontSize="12"/>
                                <TextBlock x:Name="ProfilePhone" Text="" Foreground="White" FontSize="15"/>
                            </StackPanel>
                            <!-- Bio -->
                            <StackPanel x:Name="ProfileBioPanel" Visibility="Collapsed" Margin="0,0,0,12">
                                <TextBlock Text="{Binding [login_about], Source={StaticResource Loc}}" Foreground="#888888" FontSize="12"/>
                                <TextBlock x:Name="ProfileBio" Text="" Foreground="White" FontSize="15" TextWrapping="Wrap"/>
                            </StackPanel>
                            <!-- Участники группы -->
                            <StackPanel x:Name="ProfileMembersPanel" Visibility="Collapsed">
                                <Rectangle Height="1" Fill="#333333" Margin="0,0,0,8"/>
                                <TextBlock Text="{Binding [chat_members], Source={StaticResource Loc}}" Foreground="#888888" FontSize="12" Margin="0,0,0,8"/>
                                <ListView x:Name="ProfileMembersList" SelectionMode="None"
                                          IsItemClickEnabled="True" ItemClick="ProfileMember_Click"
                                          MaxHeight="300">
                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="ListViewItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            <Setter Property="Padding" Value="0"/>
                                        </Style>
                                    </ListView.ItemContainerStyle>
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Padding="0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="40"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Ellipse Width="36" Height="36" Fill="{Binding AvatarColor}" Visibility="{Binding NoPhotoVisibility}"/>
                                                <TextBlock Text="{Binding AvatarInitials}" Width="36" Height="36"
                                                           TextAlignment="Center" Foreground="White" FontSize="14" FontWeight="SemiBold"
                                                           Margin="0,9,0,0" Visibility="{Binding NoPhotoVisibility}"/>
                                                <Ellipse Width="36" Height="36">
                                                    <Ellipse.Fill>
                                                        <ImageBrush ImageSource="{Binding Photo}" Stretch="UniformToFill"/>
                                                    </Ellipse.Fill>
                                                </Ellipse>
                                                <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding FullName}" Foreground="White" FontSize="14" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding LastSeen}" Foreground="#2AABEE" FontSize="11"
                                                               Visibility="{Binding LastSeenVisibility}"/>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                            <!-- Кнопка закрыть -->
                            <Button Content="{Binding [ui_close], Source={StaticResource Loc}}" Click="ProfileOverlay_Close"
                                    HorizontalAlignment="Center" Margin="0,8,0,0"
                                    Background="#2A2A2E" Foreground="White"
                                    Padding="30,8"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- Оверлей записи видеокружочка -->
            <Grid x:Name="VideoNoteOverlay" Visibility="Collapsed"
                  Background="#CC000000" Grid.Row="2">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <!-- Круглый превью с камеры -->
                    <Border Width="240" Height="240" HorizontalAlignment="Center"
                            CornerRadius="120" Background="Black">
                        <CaptureElement x:Name="VideoNotePreview" Width="240" Height="240"
                                        Stretch="UniformToFill"
                                        RenderTransformOrigin="0.5,0.5">
                            <CaptureElement.RenderTransform>
                                <RotateTransform Angle="270"/>
                            </CaptureElement.RenderTransform>
                        </CaptureElement>
                    </Border>
                    <Ellipse x:Name="VideoNoteProgressRing" Width="248" Height="248"
                             Stroke="#2AABEE" StrokeThickness="4" Fill="Transparent"
                             HorizontalAlignment="Center" Margin="0,-248,0,0"/>
                    <!-- Таймер -->
                    <TextBlock x:Name="VideoNoteTimer" Text="0:00" Foreground="White"
                               FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center"
                               Margin="0,16,0,8"/>
                    <TextBlock Text="{Binding [chat_releaseToSend], Source={StaticResource Loc}}" Foreground="#AAAAAA"
                               FontSize="13" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>

            </Grid><!-- конец обёрточного Grid Row=1 -->

            <Grid Grid.Row="2" x:Name="LoadingIndicator" Visibility="Collapsed">
                <ProgressRing IsActive="True" Width="60" Height="60" Foreground="#0088cc" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding [ui_loading], Source={StaticResource Loc}}" Foreground="#888888" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,80,0,0"/>
            </Grid>

            <StackPanel x:Name="InputPanel" Grid.Row="3">
                <!-- Кнопка Старт для ботов -->
                <Button x:Name="StartBotButton" Content="{Binding [ui_start], Source={StaticResource Loc}}"
                        Visibility="Collapsed" Click="StartBotButton_Click"
                        HorizontalAlignment="Center" Margin="0,8,0,8"
                        Background="#2AABEE" Foreground="White"
                        FontSize="16" FontWeight="SemiBold"
                        Padding="40,12"/>
                <!-- Панель предпросмотра цитаты -->
                <Grid x:Name="ReplyPreviewPanel" Visibility="Collapsed" Background="#1A1A1A" Padding="10,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding [msgmenu_reply], Source={StaticResource Loc}}" Foreground="#0088cc" FontSize="11" FontWeight="SemiBold"/>
                        <TextBlock x:Name="ReplyPreviewText" Text="" Foreground="#AAAAAA" FontSize="12"
                                   TextTrimming="CharacterEllipsis" MaxLines="1"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="✕" Click="CancelReply_Click"
                            Background="Transparent" Foreground="#888888" FontSize="14"
                            Width="36" Height="36" Padding="0"/>
                </Grid>

                <Grid x:Name="InputBorder" Padding="10" Background="#222222">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Меню вложений: файл + видеосообщение -->
                <Button x:Name="AttachMenuButton" Grid.Column="0" Content="+"
                        Width="44" Height="40" Padding="0"
                        Background="Transparent" Foreground="White"
                        BorderThickness="0" FontSize="26" FontWeight="SemiBold">
                    <Button.Flyout>
                        <MenuFlyout Placement="Top">
                            <MenuFlyoutItem Text="{Binding [attach_file], Source={StaticResource Loc}}" Click="AttachFile_Click"/>
                            <MenuFlyoutItem Text="{Binding [attach_videoNote], Source={StaticResource Loc}}" Click="VideoNoteMode_Click"/>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>

                <!-- Поле ввода: смайлик внутри поля -->
                <Border x:Name="MessageInputBorder" Grid.Column="1" Margin="8,0"
                        Background="#F0F2F5" BorderBrush="#D8DCE0" BorderThickness="1" CornerRadius="20" Padding="2,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="StickerButton" Grid.Column="0" Content="😊" Click="StickerButton_Click"
                                Width="36" Height="36" Padding="0" Margin="1,0,0,0"
                                Background="Transparent" Foreground="#666666"
                                BorderThickness="0" FontSize="18" VerticalAlignment="Bottom"/>
                        <TextBox x:Name="MessageInput" Grid.Column="1"
                                 PlaceholderText="{Binding [chat_message], Source={StaticResource Loc}}" AcceptsReturn="True" MaxHeight="100"
                                 Background="Transparent" BorderThickness="0" VerticalAlignment="Center"
                                 Foreground="#222222" Style="{StaticResource ChatInputStyle}"
                                 TextChanged="MessageInput_TextChanged"
                                 Holding="MessageInput_Holding">
                            <FlyoutBase.AttachedFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="{Binding [ui_pasteText], Source={StaticResource Loc}}" Click="PasteToInput_Click"/>
                                </MenuFlyout>
                            </FlyoutBase.AttachedFlyout>
                        </TextBox>
                    </Grid>
                </Border>

                <!-- Микрофон и отправка занимают одну ячейку и переключаются -->
                <Grid Grid.Column="2" Width="50" Height="40">
                    <Border x:Name="MicButton" Background="Transparent" CornerRadius="8"
                            PointerPressed="RecordButton_PointerPressed"
                            PointerReleased="RecordButton_PointerReleased"
                            PointerExited="RecordButton_PointerReleased">
                        <TextBlock x:Name="RecordGlyph" Text="🎤" FontSize="18"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <Button x:Name="SendButton" Content="➤" Click="SendMessage_Click" IsTabStop="False"
                            Width="50" Height="40" Padding="0" Visibility="Collapsed"
                            Background="#0088cc" Foreground="White"/>
                </Grid>
            </Grid>

            <!-- Панель выбора стикеров — поверх сообщений снизу -->
            <Grid x:Name="StickerPanel" Visibility="Collapsed"
                  Grid.Row="2" VerticalAlignment="Bottom" Background="#1A1A1A" Height="280">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <!-- Вкладки стикерпаков -->
                <ScrollViewer HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled"
                              HorizontalScrollBarVisibility="Hidden" Height="48" Background="#222222">
                    <StackPanel x:Name="StickerPackTabs" Orientation="Horizontal" Padding="4"/>
                </ScrollViewer>
                <!-- Сетка стикеров -->
                <ScrollViewer Grid.Row="1" VerticalScrollMode="Enabled" VerticalScrollBarVisibility="Hidden">
                    <GridView x:Name="StickerGrid" SelectionMode="None" IsItemClickEnabled="True"
                              ItemClick="StickerGrid_ItemClick" Padding="4">
                        <GridView.ItemContainerStyle>
                            <Style TargetType="GridViewItem">
                                <Setter Property="Padding" Value="2"/>
                                <Setter Property="Margin" Value="0"/>
                            </Style>
                        </GridView.ItemContainerStyle>
                        <GridView.ItemTemplate>
                            <DataTemplate>
                                <Border Width="80" Height="80" Background="Transparent">
                                    <Image Source="{Binding Thumb}" Stretch="Uniform" Width="72" Height="72"/>
                                </Border>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>
                </ScrollViewer>
                <!-- Индикатор загрузки с прогрессом -->
                <StackPanel x:Name="StickerLoadingPanel" Grid.Row="1"
                            HorizontalAlignment="Center" VerticalAlignment="Top"
                            Margin="0,8,0,0" Visibility="Collapsed">
                    <TextBlock x:Name="StickerLoadingText"
                               Text="{Binding [ui_loading], Source={StaticResource Loc}}" Foreground="#888888" FontSize="13"
                               HorizontalAlignment="Center"/>
                    <TextBlock x:Name="StickerProgressText"
                               Text="" Foreground="#555555" FontSize="11"
                               HorizontalAlignment="Center" Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>

            </StackPanel>
        </Grid>


        <!-- Оверлей контактов -->
        <Grid x:Name="ContactsOverlay" Visibility="Collapsed" Background="#DD000000"
              Grid.Row="0" Grid.RowSpan="2">
            <Border Background="#222222" CornerRadius="12" Margin="20,60"
                    VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <!-- Шапка -->
                    <Grid Background="#0088cc" Padding="16,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding [chat_contacts], Source={StaticResource Loc}}" Foreground="White" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Content="✕" Click="ContactsOverlay_Close"
                                Background="Transparent" Foreground="White" FontSize="16"
                                Width="36" Height="36" Padding="0"/>
                    </Grid>
                    <!-- Список контактов -->
                    <Grid Grid.Row="1">
                        <ListView x:Name="ContactsListView" IsItemClickEnabled="True"
                                  ItemClick="ContactItem_Click" Background="Transparent">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="8,6" MinWidth="200">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="46"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Width="40" Height="40" HorizontalAlignment="Left">
                                            <Ellipse.Fill>
                                                <ImageBrush ImageSource="{Binding Photo}" Stretch="UniformToFill"/>
                                            </Ellipse.Fill>
                                        </Ellipse>
                                        <Ellipse Width="40" Height="40" Fill="{Binding AvatarColor}"
                                                 HorizontalAlignment="Left"
                                                 Visibility="{Binding NoPhotoVisibility}"/>
                                        <TextBlock Text="{Binding AvatarInitials}" Width="40" Height="40"
                                                   HorizontalAlignment="Left" TextAlignment="Center"
                                                   Foreground="White" FontSize="15" FontWeight="SemiBold"
                                                   Margin="0,11,0,0" Visibility="{Binding NoPhotoVisibility}"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                                            <TextBlock Text="{Binding FullName}" Foreground="White" FontSize="15" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Username}" Foreground="#888888" FontSize="12"
                                                       Visibility="{Binding UsernameVisibility}"/>
                                            <TextBlock Text="{Binding LastSeen}" Foreground="#2AABEE" FontSize="11"
                                                       Visibility="{Binding LastSeenVisibility}"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <TextBlock x:Name="ContactsLoadingText" Text="{Binding [ui_loading], Source={StaticResource Loc}}" Foreground="#888888"
                                   FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="Collapsed"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Оверлей выбора чата для пересылки -->
        <Grid x:Name="ForwardOverlay" Visibility="Collapsed" Background="#DD000000"
              Grid.Row="0" Grid.RowSpan="2">
            <Border Background="#222222" CornerRadius="12" Margin="20,60"
                    VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <!-- Шапка -->
                    <Grid Background="#0088cc" Padding="16,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding [chat_forwardTo], Source={StaticResource Loc}}" Foreground="White" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Content="✕" Click="ForwardOverlay_Close"
                                Background="Transparent" Foreground="White" FontSize="16" Width="40" Height="40" Padding="0"/>
                    </Grid>
                    <!-- Список чатов -->
                    <ListView x:Name="ForwardChatListOld" Grid.Row="1"
                              SelectionMode="None" IsItemClickEnabled="True"
                              ItemClick="ForwardChatListOld_ItemClick">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="16,8"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="40" Height="40" CornerRadius="20" Background="#555555" Margin="0,0,12,0">
                                        <Image Source="{Binding Photo}" Stretch="UniformToFill" Width="40" Height="40"/>
                                    </Border>
                                    <TextBlock Text="{Binding Title}" Foreground="White" FontSize="15"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
        </Grid>

        <!-- Полноэкранный просмотр фото -->
        <Grid x:Name="PhotoOverlay" Visibility="Collapsed" Background="#DD000000"
              Grid.Row="0" Grid.RowSpan="2">
            <ScrollViewer ZoomMode="Enabled" MinZoomFactor="1" MaxZoomFactor="5"
                          HorizontalScrollMode="Enabled" VerticalScrollMode="Enabled"
                          HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"
                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <Grid Width="{Binding ActualWidth, ElementName=PhotoOverlay}"
                      Height="{Binding ActualHeight, ElementName=PhotoOverlay}">
                    <Image x:Name="PhotoOverlayImage" Stretch="Uniform"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
            </ScrollViewer>
            <Button Content="✕" Click="PhotoOverlay_Tapped"
                    HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,8,8,0" Width="44" Height="44"
                    Background="#88000000" Foreground="White" FontSize="18" Padding="0"/>
            <Button Content="💾" Click="PhotoOverlaySave_Click"
                    HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,8,60,0" Width="44" Height="44"
                    Background="#88000000" Foreground="White" FontSize="18" Padding="0"/>
            <TextBlock x:Name="PhotoOverlayStatus" Text="" Foreground="White"
                       VerticalAlignment="Bottom" HorizontalAlignment="Center"
                       FontSize="14" Margin="0,0,0,16"/>
        </Grid>
    </Grid>
</Page>
